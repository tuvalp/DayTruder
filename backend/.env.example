# ── IBKR Connection ───────────────────────────────────────────────────────────
# TWS or IB Gateway must be running. Enable API in:
#   TWS → Edit → Global Configuration → API → Settings
#   ✅ Enable ActiveX and Socket Clients   ✅ Allow localhost only

IBKR_HOST=127.0.0.1

# TWS Paper=7497  TWS Live=7496  Gateway Paper=4002  Gateway Live=4001
IBKR_PORT=7496

IBKR_CLIENT_ID=1

# Optional — account is auto-detected from TWS on connect.
# Only set this if you have multiple accounts and want to force a specific one.
# IBKR_ACCOUNT=U1234567

# ── Market Data ───────────────────────────────────────────────────────────────
# Free key at https://finnhub.io (no credit card, 60 calls/min free)
FINNHUB_API_KEY=your_finnhub_key_here

# ── AI ────────────────────────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXX
CLAUDE_MODEL=claude-sonnet-4-6

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://alphaagent:alphaagent@localhost:5432/alphaagent
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development

# Risk & scanner thresholds are managed in the UI (Settings tab).
# No need to set them here.
