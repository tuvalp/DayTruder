# ── Brokerage ────────────────────────────────────────────────────────────────
# Get from https://app.alpaca.markets  (use paper keys first!)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=wss://stream.data.alpaca.markets

# ── AI ────────────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://alphaagent:alphaagent@localhost:5432/alphaagent
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development

# ── Risk defaults (all overridable at runtime) ────────────────────────────────
MAX_RISK_PER_TRADE_PCT=1.5
STOP_LOSS_PCT=4
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=6

# ── Scanner thresholds ────────────────────────────────────────────────────────
MIN_PRICE=1
MAX_PRICE=10
MIN_RELATIVE_VOLUME=3
MAX_FLOAT_M=20
MIN_PRICE_SURGE_PCT=5
